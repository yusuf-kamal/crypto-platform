# Copy to .env and fill in the values. Never commit .env.
# Secrets are intentionally left blank here.

# --- Object storage (S3-compatible lake: bronze / silver / gold buckets) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Airflow metadata database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# --- Airflow secrets ---
# Generate each one with:
#   docker run --rm python:3.12-slim python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# --- Warehouse (SQL Server on the host machine) ---
# MSSQL_HOST is reached from inside the containers, so keep host.docker.internal
# unless SQL Server itself runs in Compose.
MSSQL_HOST=host.docker.internal
MSSQL_PORT=14330
MSSQL_DB=CryptoDWH
# The least-privilege login created in sql/01_create_gold.sql (see README step 2).
MSSQL_USER=crypto_app
MSSQL_PASSWORD=
