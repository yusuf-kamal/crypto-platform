# Copy to .env and fill in the values. Never commit .env.
# Secrets are intentionally left blank here.

# --- Object storage (S3-compatible lake: bronze / silver / gold buckets) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Airflow metadata database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# --- Airflow secrets ---
# Generate each one with:
#   docker run --rm python:3.12-slim python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# --- Warehouse (SQL Server, running in Compose) ---
# MSSQL_HOST/PORT are how the containers reach it, so they stay mssql:1433.
# To use a SQL Server on the host instead, set host.docker.internal and its
# port, and stop the mssql service.
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DB=CryptoDWH
# Port published on the host, for SSMS or Azure Data Studio.
MSSQL_HOST_PORT=14330
# sa is used only by mssql-init to create everything.
MSSQL_SA_PASSWORD=
# The least-privilege login the pipeline uses; mssql-init creates it with
# this password.
MSSQL_USER=crypto_app
MSSQL_PASSWORD=

# --- Data lake ---
# Silver is written as Delta Lake. Set to parquet to fall back to the
# previous behaviour without touching any job.
LAKE_FORMAT=delta

# --- Alerting (optional) ---
# A Slack-style incoming webhook. Leave empty for log-only failure alerts.
ALERT_WEBHOOK_URL=

# --- Host-dependent settings ---
# Spark driver heap. It has to fit inside the Docker Desktop memory limit
# together with the other containers; a driver larger than the limit never
# starts and says little about why. Lower it along with the scope in
# src/common/config.py on a smaller machine.
SPARK_DRIVER_MEMORY=6g

# Platform for the SQL Server image. Microsoft publishes no arm64 build, so on
# Apple Silicon this stays linux/amd64 and Docker Desktop needs "Use Rosetta
# for x86/amd64 emulation" switched on.
MSSQL_PLATFORM=linux/amd64
